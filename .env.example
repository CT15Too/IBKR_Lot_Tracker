# This file configures BROWSER (source) development only: python3 run.py.
# Installed desktop builds read settings from the OS data directory and store
# the Flex token in the OS credential store — they do not use .env.
#
# --- IBKR Flex Web Service ---
# Client Portal > Performance & Reports > Flex Queries > Flex Web Service Configuration
# Toggle it on to get your token.
IBKR_FLEX_TOKEN=

# Client Portal > Performance & Reports > Flex Queries
# Create (or open) your "Open Positions - Lots" query, click the query,
# the number in the URL / query list is the Query ID.
IBKR_FLEX_QUERY_ID=

# --- App settings ---
# How often the app is allowed to re-pull the Flex report, in minutes.
# IBKR data itself only updates every 15-30 min, so there's no benefit going lower.
# Keep this at 15+ to stay well clear of IBKR's rate limits.
FLEX_MIN_REFRESH_MINUTES=15

# Where the local SQLite database file is stored.
DATABASE_PATH=./data/lots.db

# Host/port for the app itself
APP_HOST=127.0.0.1
APP_PORT=8000
